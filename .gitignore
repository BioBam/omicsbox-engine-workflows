# Nextflow temporary working directory
work/

# Nextflow hidden cache and history directory
.nextflow/

# Ignore all Nextflow hidden files and logs
.nextflow*

#Ignore windows zone identifier metadata
*:Zone.Identifier

#Ignore results folder
results/

# Snakemake metadata and caches
.snakemake/

# Config templates exported via `snakemake ... dump_config`
*.config.yaml

# Python caches
__pycache__/
*.pyc

