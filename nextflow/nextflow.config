// --- FILE: nextflow.config ---
// Root Nextflow configuration for all OmicsBox DSL2 workflows.
// =================================================================

// ---------------------------------------------------
// DOCKER CONFIGURATION
// ---------------------------------------------------
docker {
    enabled    = false
    runOptions = '-u $(id -u):$(id -g)'
}

// ---------------------------------------------------
// GLOBAL PIPELINE PARAMETERS
// ---------------------------------------------------
params {
    dump_config = false             // Flag to dump the configuration parameters to a file
    omicsboxImage = null            // No OmicsBox container image published yet; the host CLI is used
    local_folder  = './results'     // Base output directory for all workflow results
}

// ---------------------------------------------------
// PROCESS DEFAULTS
// ---------------------------------------------------
process {
    container = params.omicsboxImage
    publishDir = [
        path:      { "${params.local_folder}/${workflow.sessionId}" },
        mode:      'link',
        overwrite: true
    ]
}
