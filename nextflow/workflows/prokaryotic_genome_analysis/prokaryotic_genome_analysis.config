// --- FILE: prokaryotic_genome_analysis.config ---
// Prokaryotic Genome Analysis pipeline configuration.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_single_end           = null         // Glob for single-end reads (e.g. 'data/*.fastq.gz')
    input_paired_end           = null         // Glob for paired-end reads (e.g. 'data/*_{1,2}.fastq.gz')
    local_folder               = './results'  // Base output directory for all workflow results
    chart_format               = 'box'        // Output chart format: [box, png, pdf, csv]

    // R1/R2 filename patterns for PAIRED-END short reads.
    //upstream_pattern   = '_1'     // R1 filename pattern for PE reads (e.g. '_1' -> sample_1.fastq.gz)
    //downstream_pattern = '_2'     // R2 filename pattern for PE reads (e.g. '_2' -> sample_2.fastq.gz)

    // ---------------------------------------------------
    // STEP-SPECIFIC PARAMETERS
    // ---------------------------------------------------

    trimmomatic {
        adapters = null  // Optional: custom adapter FASTA file for trimming
    }

    fastqc {
        adapters     = null  // Optional: custom adapter FASTA file for QC screening
        contaminants = null  // Optional: custom contaminant FASTA file for QC screening
    }

    spades {
        // paired_end_library_type = null  // REQUIRED if using paired-end reads. Biological library type of trimmed PE reads.
                                        // Options: paired-end-fr, paired-end-rf, paired-end-ff,
                                        // hq-mate-pair-fr, hq-mate-pair-rf, hq-mate-pair-ff, nxmate
        // Optional Mate-Pair reads (3 orientations; triggers --use-mp-optional-data=true if any provided)
    opt_mp_fr           = null         // Optional: Mate-pair reads (FR orientation) glob pattern
    opt_mp_rf           = null         // Optional: Mate-pair reads (RF orientation) glob pattern
    opt_mp_ff           = null         // Optional: Mate-pair reads (FF orientation) glob pattern

    // Optional Hybrid Assembly inputs (triggers --use-data-for-hybrid-assembly=true if any provided)
    sanger              = null         // Optional: Sanger sequencing reads glob pattern
    pacbio              = null         // Optional: PacBio long reads for hybrid assembly glob pattern
    nanopore            = null         // Optional: Nanopore long reads for hybrid assembly glob pattern
    trusted_contigs     = null         // Optional: Trusted contigs for hybrid assembly glob pattern
    untrusted_contigs   = null         // Optional: Untrusted contigs for hybrid assembly glob pattern
    }

    quast {
        reference_genome = null  // Path to reference genome FASTA file (required for QUAST)
    }

    glimmer {
        icm_model = null  // Optional: Path to existing Glimmer ICM model file. If not provided, Glimmer will create a new model.
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: RAW QUALITY CONTROL (PRE-TRIMMING)
    // =================================================================
    withName: 'FASTQC_RAW' {
        ext.outdir = '01_fastqc_raw'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: READ PREPROCESSING & TRIMMING
    // =================================================================
    withName: 'TRIMMOMATIC' {
        ext.outdir = '02_trimmomatic'
        ext.args = [
            "--quality-encoding=auto",               // [auto, phred33, phred64] Auto-detect read quality encoding. Default: auto

            // -- Adapter Removal --
            // "--prefix=trimmed_",                  // Output filename prefix
            "--remove-adapters=false",               // [true, false] Enable adapter/contaminant trimming. Default: false
            // "--adapter-options=default",          // [default, custom] Adapter removal strategy (only if remove-adapters=true)
            // "--adapter-list=TruSeq3-SE.fa",       // [TruSeq3-SE.fa, TruSeq2-SE.fa, NexteraPE-PE.fa] Adapter list (only if adapter-options=default)
            // "--seed-mismatches=2",                // Max mismatches for full adapter match (only if remove-adapters=true)
            // "--simple-clip-threshold=15",         // Simple adapter match accuracy threshold (only if remove-adapters=true)
            // "--palindrome-clip-threshold=30",     // PE palindrome clip accuracy threshold (only if remove-adapters=true; PAIRED-END only - OmicsBox errors if set with single-end)

            // -- Paired-End Mode -- (PAIRED-END ONLY, do not enable for single-end input)
            // "--min-adapter-length=8",             // Min detectable adapter length (only if remove-adapters=true; PAIRED-END only - OmicsBox errors if set with single-end)
            // "--keep-both-reads=true",             // Retain reverse read after PE palindrome detection (only if remove-adapters=true; PAIRED-END only - OmicsBox errors if set with single-end)

            // -- Edge Trimming --
            "--edge-trimming=false",                 // [true, false] Enable edge trimming. Default: false
            // "--edge-trimming-options=qual",       // [qual, length] Edge trimming strategy (only if edge-trimming=true)
            // "--qual-trimming-from5p=true",        // Trim low-quality bases from 5' (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold5p=30",   // Min quality threshold at 5' (only if qual-trimming-from5p=true)
            // "--qual-trimming-from3p=true",        // Trim low-quality bases from 3' (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold3p=30",   // Min quality threshold at 3' (only if qual-trimming-from3p=true)
            // "--length-trimming-from5p=false",     // Crop N bases from 5' (only if edge-trimming-options=length)
            // "--length-trimming-threshold5p-remove=3",  // Bases to remove from 5' (only if length-trimming-from5p=true)
            // "--length-trimming-from3p=false",     // Crop to fixed length from 3' (only if edge-trimming-options=length)
            // "--length-trimming-threshold3p-keep=150",  // Bases to keep from start (only if length-trimming-from3p=true)

            // -- Quality Trimming --
            "--quality-trimming=false",           // [true, false] Enable sliding-window or maxinfo trimming
            // "--quality-trimming-options=sliding", // [sliding, maxinfo] Quality trimming strategy (only if quality-trimming=true)
            // "--window-size=4",                    // Sliding window width (only if quality-trimming-options=sliding)
            // "--required-quality=15",              // Min avg quality in window (only if quality-trimming-options=sliding)
            // "--target-length=40",                 // Target read length for maxinfo (only if quality-trimming-options=maxinfo)
            // "--strictness=0.5",                   // [0..1] Length vs correctness tradeoff (only if quality-trimming-options=maxinfo)

            // -- Quality & Length Filtering --
            "--filter-by-quality=true",              // [true, false] Discard reads below average quality. Default: true
            "--average-quality=25",                  // [integer] Min average quality to retain a read (only if filter-by-quality=true)
            "--filter-by-length=true",               // [true, false] Discard reads below minimum length. Default: true
            "--minimum-length=36"                    // [integer] Minimum retained read length in bp (only if filter-by-length=true)
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: QUALITY CONTROL (POST-TRIMMING)
    // =================================================================
    withName: 'FASTQC_POST' {
        ext.outdir = '03_fastqc_post'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: DE NOVO GENOME ASSEMBLY
    // =================================================================
    withName: 'SPADES' {
        ext.outdir = '04_spades'
        ext.args = [
            // -- Data Type --
            "--ion-torrent=false",                   // [true, false] Enable for IonTorrent data. Default: false
            "--single-cell=false",                   // [true, false] Enable for single-cell MDA data. Default: false

            "--automatic-kmer-sizes=true",           // [true, false] Auto-select k-mer sizes. Default: true
            // "--kmer-sizes=33,55",                 // Comma-separated k-mer sizes (must be odd, <128) (only if automatic-kmer-sizes=false)
            "--error-correction=true",               // [true, false] Perform read error correction before assembly. Default: true
            "--careful=false",                       // [true, false] Reduce mismatches and short indels. Default: false
            "--coverage-cutoff=off",                 // [off, auto, value] Coverage cutoff strategy. Default: off
            // "--coverage-cutoff-value=20.0",       // [float] Coverage threshold value (only if coverage-cutoff=value)
            "--save-graph=true"                     // [true, false] Save assembly graphs in GFA format. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 5: ASSEMBLY QUALITY ASSESSMENT (QUAST)
    // =================================================================
    withName: 'QUAST' {
        ext.outdir = '05_quast'
        ext.args = [
            // -- Assemblies --
            "--genome-type=prokaryote",              // [prokaryote, eukaryote, large] Genome type. Default: eukaryote

            // -- Reference --
            "--fragmented=false",                    // [true, false] Reference is fragmented. Default: false

            "--replace-non-atgc=true",               // [true, false] Replace non-ATGC chars with N. Default: true

            // -- Contigs Parameters --
            "--min-contig=500",                      // [integer >=65] Min contig length in bp. Default: 500

            // -- Alignment Parameters --
            "--min-alignment=65",                    // [integer >=65] Min alignment length in bp. Default: 65
            "--min-identity=95.0",                   // [float >=80.0] Min identity % for alignment. Default: 95.0

            // -- Misassemblies Parameters --
            "--ext-mis-size=1000",                   // [integer] Extensive misassembly size threshold. Default: 1000
            "--local-mis-size=200",                  // [integer >=10] Local misassembly size threshold. Default: 200
            "--scaffold-max-size=10000"              // [integer] Max scaffold gap length difference before an inconsistency counts as an extensive misassembly (only relevant if > ext-mis-size). Default: 10000
        ].join(' ')
    }

    // =================================================================
    // PHASE 6: ASSEMBLY COMPLETENESS ASSESSMENT (BUSCO)
    // =================================================================
    withName: 'BUSCO' {
        ext.outdir = '06_busco'
        ext.args = [
            "--mode=genome",                         // [genome, transcriptome, proteins] Assessment mode
            "--blast-expect-value=1e-03",            // [enum] E-value threshold for BLAST. Default: 1e-03
            "--lineage=bacteria_odb10.2020-03-06.tar.gz",                 // Lineage-specific BUSCO profile (optional but recommended)
        ].join(' ')
    }

    // =================================================================
    // PHASE 7: PROKARYOTIC GENE FINDING
    // =================================================================
    withName: 'GLIMMER' {
        ext.outdir = '07_glimmer'
        ext.args = [
            // -- Gene Settings --
            "--genetic-code=11",                     // [1, 4, 11] Genetic code table. Default: 11 (bacterial)
            "--setminlenght=110",                    // [integer >=1] Min ORF length in bp. Default: 110
            "--max-overlap=30",                      // [integer >=0] Max gene overlap in bp. Default: 30
            "--min-score=30",                        // [integer >=2] Min ORF score for gene call. Default: 30
            "--genome-shape=circular",            // DISABLED: OmicsBox registers this flag name with a trailing space (tool bug) and rejects it ("Unknown option"). Default is already circular, so omitting it keeps circular topology.

            // Advanced parameters (Uncomment ONLY if creating a new model, i.e., glimmer.icm_model = null):
            // "--advenced-icm=true",                // [true, false] Modify ICM creation parameters. Default: false

            // -- Advanced ICM Settings --
            // "--frame-stop=false",                 // [true, false] Include in-frame stop codons in ICM. Default: false
            // "--depth=7",                          // [integer] ICM max context depth. Default: 7
            // "--width=12",                         // [integer] ICM context window width. Default: 12
            // "--period=3",                         // [integer] ICM period for submodels. Default: 3
            // "--entropy=1.15",                     // [float] Entropy distance filter for training. Default: 1.15
            "--save=true",                        // [true, false] Save new ICM for reuse. Default: false

            "--species=iterated",                    // [single, iterated] Run mode. Default: iterated

            // -- Advanced Parameters --
            "--enable-content-gc=false",           // [true, false] Set custom GC content. Default: false
            // "--content-gc2=42.6",                 // [string] GC content %. (Requires --enable-content-gc=true)
            "--enable-start-codons=false",         // [true, false] Set custom start codons. Default: false
            // "--start-codons=atg, gtg, ttg",       // [string] Start codons. (Requires --enable-start-codons=true)
            // "--start-codons-weight=0.804, 0.077, 0.12", // [string] Start codon weights. (Requires --enable-start-codons=true)
            "--enable-stop-codons=false",          // [true, false] Set custom stop codons. Default: false
            // "--stop-codons=tag, tga, taa"         // [string] Stop codons. (Requires --enable-stop-codons=true)
        ].join(' ')
    }

    // =================================================================
    // PHASE 8: FUNCTIONAL ANNOTATION (DIAMOND)
    // =================================================================
    withName: 'DIAMOND_BLAST' {
        ext.outdir = '08_diamond'
        ext.args = [
            "--blast-mode=blastx",                   // [blastx, blastp] Query mode: blastx for genes, blastp for proteins. Default: blastx
            "--sensitivity=more_sensitive",          // [fast, mid_sensitive, standard, sensitive, more_sensitive, very_sensitive, ultra_sensitive]
            "--database=swissprot_20250925",                      // [nr, refseq_nr, swissprot, custom] NCBI database to query

            // -- Target Database --
            "--species=2157,2",                 // Taxonomies to include/exclude (optional)
            "--taxa-filter-option=included",  // [included, excluded] Include or exclude the selected taxonomies. Default: included

            "--blast-expect-value=1.0E-3",           // [enum] E-value threshold for significance. Default: 1.0E-3
            // "--long-queries=false",                  // [true, false] Optimize for queries >=30kbp. Default: false Only allowed with blastx.
            "--number-of-hits=20",                   // [1-100] Max sequence alignments to retrieve. Default: 20
            "--blast-min-hsplength=33",              // [1-5000] Min HSP length in bp/aa. Default: 33
            "--hsp-hit-coverage-cutoff=0"            // [0-100] Min HSP coverage % of Hit sequence. Default: 0
        ].join(' ')
    }

}
