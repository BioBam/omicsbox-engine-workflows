// --- FILE: long_reads_prokaryotic_genome_analysis.config ---
// Long-Read Prokaryotic Genome Analysis pipeline configuration.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_long_reads           = null         // REQUIRED: Long reads (e.g. 'data/*.fastq.gz')
    input_single_end           = null         // Short reads: Single-end (optional for BWA)
    input_paired_end           = null         // Short reads: Paired-end (optional for BWA)
    local_folder               = './results'  // Base output directory for all workflow results
    chart_format               = 'box'        // Output chart format: [box, png, pdf, csv]

    // R1/R2 filename patterns for PAIRED-END short reads.
    //upstream_pattern   = '_1'     // R1 filename pattern for PE reads (e.g. '_1' -> sample_1.fastq.gz)
    //downstream_pattern = '_2'     // R2 filename pattern for PE reads (e.g. '_2' -> sample_2.fastq.gz)

    // ---------------------------------------------------
    // LONG-READ SPECIFIC PARAMETERS
    // ---------------------------------------------------
    flye {
        library_type = null                   // REQUIRED: Options: pacbio_raw, pacbio_corr, pacbio_hifi, nano_raw, nano_corr
    }

    glimmer {
        icm_model = null                      // Optional: Path to existing ICM model file. If null, Glimmer creates new model.
    }

    quast {
        reference_genome = null               // Reference genome for QUAST evaluation
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: LONG-READ QUALITY CONTROL (LONGQC)
    // =================================================================
    withName: 'LONGQC' {
        ext.outdir = '01_longqc'
        ext.args = [
            "--preset=pb-rs2",             // [pb-rs2, pb-sequel, pb-hifi, ont-ligation, ont-rapid, ont-1dsq] Sequencing technology profile
            "--output-trimmed=true",          // [true, false] REQUIRED: true to feed trimmed reads to Flye. Default: true
            "--transcript=false",             // [true, false] Analyze transcripts, RNA, or cDNA sequences. Default: false
            "--short-mode=false"              // [true, false] Highly sensitive setting for short/erroneous reads. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: DE NOVO LONG-READ ASSEMBLY (FLYE)
    // =================================================================
    withName: 'FLYE' {
        ext.outdir = '02_flye'
        ext.args = [
            "--reduce-ram=false",                 // [true, false] Reduce memory usage for high coverage. Default: false
            // "--estimated-genome-size=100m",    // [string] e.g., 5m, 2.6g. (Requires --reduce-ram=true)
            // "--asm-cov=40",                    // [integer] Target coverage for initial disjointigs. (Requires --reduce-ram=true)

            "--min-overlap-auto=true",            // [true, false] Choose overlap automatically. Default: true
            // "--min-overlap=3000",              // [integer 1000-10000] Manual overlap length. (Requires --min-overlap-auto=false)

            "--polishing=false",                  // [true, false] Internal polishing. Default: false (We use Pilon downstream)
            // "--pol-iterations=1",              // [integer >=1] Number of iterations. (Requires --polishing=true)

            "--keep-haplotypes=false",            // [true, false] Do not collapse alternative haplotypes. Default: false
            "--save-graph=true"                  // [true, false] Save repeat graph in .gfa format. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: ASSEMBLY QUALITY ASSESSMENT (QUAST)
    // =================================================================
    withName: 'QUAST' {
        ext.outdir = '03_quast'
        ext.args = [
            // -- Assemblies --
            "--genome-type=prokaryote",       // [prokaryote, eukaryote, large] Genome type. Default: prokaryote for this workflow

            // -- Reference --
            "--fragmented=false",             // [true, false] Reference is fragmented. Default: false

            "--replace-non-atgc=true",        // [true, false] Replace non-ATGC with N. Default: true

            // -- Contigs Parameters --
            "--min-contig=500",               // [integer >=65] Min contig length. Default: 500

            // -- Alignment Parameters --
            "--min-alignment=65",             // [integer >=65] Min alignment length. Default: 65
            "--min-identity=95.0",            // [float >=80.0] Min identity %. Default: 95.0

            // -- Misassemblies Parameters --
            "--ext-mis-size=1000",            // [integer] Extensive misassembly threshold. Default: 1000
            "--local-mis-size=200",           // [integer >=10] Local misassembly threshold. Default: 200
            "--scaffold-max-size=10000"       // [integer] Max scaffold gap length difference before an inconsistency counts as an extensive misassembly (only relevant if > ext-mis-size). Default: 10000
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: SHORT-READ ALIGNMENT & INDEXING (BWA)
    // =================================================================
    withName: 'BWA' {
        ext.outdir = '04_bwa'
        ext.args = [
            // -- Algorithm --
            "--minimum-seed-length=19",            // [integer] Default: 19
            "--band-width=100",                    // [integer] Default: 100
            "--z-dropoff=100",                     // [integer] Default: 100
            "--trigger-re-seeding=1.5",            // [float] Default: 1.5
            "--seed-occurrence=20",                // [integer] Default: 20
            "--skip-seeds=500",                    // [integer] Default: 500
            "--drop-chains=0.5",                   // [float] Default: 0.5
            "--discard-chains=0",                  // [integer] Default: 0
            "--mate-rescue-rounds=50",             // [integer] Default: 50
            "--skip-mate-rescue=false",            // [true, false] Default: false
            "--skip-pairing=false",                // [true, false] Default: false

            // -- Scoring --
            "--matching-score=1",                  // [integer] Default: 1
            "--mismatch-penalty=4",                // [integer] Default: 4
            "--gap-open-penalty-deletion=6",       // [integer] Default: 6
            "--gap-open-penalty-insertion=6",      // [integer] Default: 6
            "--gap-extension-penalty-deletion=1",  // [integer] Default: 1
            "--gap-extension-penalty-insertion=1", // [integer] Default: 1
            "--five-clipping-penalty=5",           // [integer] Default: 5
            "--three-clipping-penalty=5",          // [integer] Default: 5
            "--unpaired-penalty=17",               // [integer] Default: 17

            // -- Output --
            "--minimum-score=30",                  // [integer] Min score to output. Default: 30
            "--primary-split-alignment=false",     // [true, false] Default: false
            "--map-qsup-alignment=false",          // [true, false] Default: false
            "--out-all-sealignments=false",        // [true, false] Default: false
            "--soft-clipping=false",               // [true, false] Default: false
            "--split-as-secondary=false",           // [true, false] Default: false
            "--sort=coordinate",                      // [coordinate, readName] How to sort BAM. Default: coordinate
            "--add-rg=true",                          // [true, false] Add Read Group header. Default: true
            "--rg-platform=ILLUMINA",                 // [ILLUMINA, IONTORRENT, HELICOS, LS454] (Requires --add-rg=true)
        ].join(' ')
    }

    // =================================================================
    // PHASE 5: ASSEMBLY POLISHING (PILON)
    // =================================================================
    withName: 'PILON' {
        ext.outdir = '05_pilon'
        ext.args = [
            "--fix-list=snps,indels,gaps,local",      // Categories to fix. Default: snps,indels,gaps,local
            "--save-changes=true",                    // [true, false] Output changes file. Default: true

            // -- Control Options --
            "--diploid=false",                     // [true, false] Sample is diploid. Default: false
            "--duplicates=false",                  // [true, false] Use reads marked as duplicates. Default: false
            "--iupac=false",                       // [true, false] Output IUPAC codes. Default: false
            "--nonpf=false",                       // [true, false] Use failed sequencer quality reads. Default: false

            // -- Heuristics Options --
            "--default-qual=10",                   // [integer] Default base quality. Default: 10
            "--flank=10",                          // [integer] Ignored bases at good read ends. Default: 10
            "--gap-margin=100000",                 // [integer] Closed gaps margin. Default: 100000
            "--kmer-size=47",                      // [integer] K-mer size. Default: 47
            "--min-depth=0.1",                     // [double] Minimum depth. Default: 0.1
            "--min-gap=10",                        // [integer] Minimum size for unclosed gaps. Default: 10
            "--min-mq=0",                          // [integer] Min mapping quality. Default: 0
            "--min-qual=0",                        // [integer] Min base quality. Default: 0
            "--no-strays=false"                    // [true, false] Skip stray pairs identification. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 6: ASSEMBLY COMPLETENESS ASSESSMENT (BUSCO)
    // =================================================================
    withName: 'BUSCO' {
        ext.outdir = '06_busco'
        ext.args = [
            "--mode=genome",                  // [genome, transcriptome, proteins] Assessment mode
            "--blast-expect-value=1e-03",      // [enum] E-value threshold. Default: 1e-03
            "--lineage=bacteria_odb10.2020-03-06.tar.gz"           // Lineage-specific BUSCO profile (optional but recommended for prokaryotes)
        ].join(' ')
    }

    // =================================================================
    // PHASE 7: PROKARYOTIC GENE FINDING (GLIMMER)
    // =================================================================
    withName: 'GLIMMER' {
        ext.outdir = '07_glimmer'
        ext.args = [
            // -- Gene Settings --
            "--genetic-code=11",                     // [1, 4, 11] Genetic code table. Default: 11 (bacterial)
            "--setminlenght=110",                    // [integer >=1] Min ORF length in bp. Default: 110
            "--max-overlap=30",                      // [integer >=0] Max gene overlap in bp. Default: 30
            "--min-score=30",                        // [integer >=2] Min ORF score for gene call. Default: 30
            "--genome-shape=circular",            // DISABLED: OmicsBox registers this flag name with a trailing space (tool bug) and rejects it ("Unknown option"). Default is already circular, so omitting it keeps circular topology.

            // Advanced parameters (Uncomment ONLY if creating a new model, i.e., glimmer.icm_model = null):
            // "--advenced-icm=true",                // [true, false] Modify ICM creation parameters. Default: false

            // -- Advanced ICM Settings --
            // "--frame-stop=false",                 // [true, false] Include in-frame stop codons in ICM. Default: false
            // "--depth=7",                          // [integer] ICM max context depth. Default: 7
            // "--width=12",                         // [integer] ICM context window width. Default: 12
            // "--period=3",                         // [integer] ICM period for submodels. Default: 3
            // "--entropy=1.15",                     // [float] Entropy distance filter for training. Default: 1.15
            "--save=true",                        // [true, false] Save new ICM for reuse. Default: false

            "--species=iterated",                    // [single, iterated] Run mode. Default: iterated

            // -- Advanced Parameters --
            "--enable-content-gc=false",           // [true, false] Set custom GC content. Default: false
            // "--content-gc2=42.6",                 // [string] GC content %. (Requires --enable-content-gc=true)
            "--enable-start-codons=false",         // [true, false] Set custom start codons. Default: false
            // "--start-codons=atg, gtg, ttg",       // [string] Start codons. (Requires --enable-start-codons=true)
            // "--start-codons-weight=0.804, 0.077, 0.12", // [string] Start codon weights. (Requires --enable-start-codons=true)
            "--enable-stop-codons=false",          // [true, false] Set custom stop codons. Default: false
            // "--stop-codons=tag, tga, taa"         // [string] Stop codons. (Requires --enable-stop-codons=true)
        ].join(' ')
    }

    // =================================================================
    // PHASE 8: FUNCTIONAL ANNOTATION (DIAMOND BLAST)
    // =================================================================
    withName: 'DIAMOND_BLAST' {
        ext.outdir = '08_diamond'
        ext.args = [
            "--blast-mode=blastx",                   // [blastx, blastp] Query mode: blastx for genes, blastp for proteins. Default: blastx
            "--sensitivity=more_sensitive",          // [fast, mid_sensitive, standard, sensitive, more_sensitive, very_sensitive, ultra_sensitive]
            "--database=swissprot_20250925",                      // [nr, refseq_nr, swissprot, custom] NCBI database to query

            // -- Target Database --
            "--species=2157,2",                 // Taxonomies to include/exclude (optional)
            "--taxa-filter-option=included",  // [included, excluded] Include or exclude the selected taxonomies. Default: included

            "--blast-expect-value=1.0E-3",           // [enum] E-value threshold for significance. Default: 1.0E-3
            // "--long-queries=false",                  // [true, false] Optimize for queries >=30kbp. Default: false Only allowed with blastx.
            "--number-of-hits=20",                   // [1-100] Max sequence alignments to retrieve. Default: 20
            "--blast-min-hsplength=33",              // [1-5000] Min HSP length in bp/aa. Default: 33
            "--hsp-hit-coverage-cutoff=0"            // [0-100] Min HSP coverage % of Hit sequence. Default: 0
        ].join(' ')
    }

    // =================================================================
    // PHASE 9: FUNCTIONAL ANNOTATION (InterProScan)
    // =================================================================
    withName: 'INTERPROSCAN' {
        ext.outdir = '09_interproscan'
        ext.args = [
            // -- Families, Domains, Sites and Repeats --
            "--ncbi-fam=true",          // [true, false] NCBIfam member database. Default: true
            "--sfld=true",              // [true, false] SFLD member database. Default: true
            "--hmm-panther=true",       // [true, false] PANTHER member database. Default: true
            "--hamap=true",             // [true, false] HAMAP member database. Default: true
            "--profile-scan=true",      // [true, false] ProfileScan member database. Default: true
            "--pattern-scan=false",     // [true, false] PatternScan member database. Default: false
            "--cdd=true",               // [true, false] CDD member database. Default: true
            "--f-print-scan=true",      // [true, false] FPrintScan member database. Default: true
            "--hmmpfam=true",           // [true, false] HMMER/Pfam member database. Default: true
            "--pirsf=true",             // [true, false] PIRSF member database. Default: true

            // -- Structural Domains --
            "--super-family=true",      // [true, false] SUPERFAMILY member database. Default: true
            "--gene3d=true",            // [true, false] Gene3D member database. Default: true

            // -- Other Sequence Features --
            "--coils=false",            // [true, false] Coils member database. Default: false

            // -- Other Categories --
            "--anti-fam=true",          // [true, false] AntiFam member database. Default: true
            "--fun-fam=true",           // [true, false] FunFam member database. Default: true
            "--pirsr=true",             // [true, false] PIRSR member database. Default: true

            "--export-format=xml,gff3"  // [xml, gff3, tsv, ...] Output export formats. Default: xml,gff3
        ].join(' ')
    }

    // =================================================================
    // PHASE 10: COMBINE PROJECTS (Merge Annotations)
    // =================================================================
    withName: 'COMBINE_PROJECTS' {
        ext.outdir = '10_combine_projects'
        ext.args = [
            "--merge-sequence-data=add",        // [add, skip, replace] Add sequences if they do not exist. Default: add
            "--merge-sequence-description=add", // [add, skip, replace] Merge headers/descriptions. Default: add
            "--merge-blast-go-mapping=add",     // [add, skip, replace] Merge candidate GO mappings. Default: add
            "--merge-go-annotation=add",        // [add, skip, replace] Merge functional GO terms. Default: add
            "--merge-ips-annotation=add",       // [add, skip, replace] Merge InterPro domain terms. Default: add
            "--main-project=project1"           // [project1, project2] Define priority project layout. Default: project1
        ].join(' ')
    }

    // =================================================================
    // PHASE 11: GENE ONTOLOGY MAPPING
    // =================================================================
    withName: 'GO_MAPPING' {
        ext.outdir = '11_go_mapping'
        ext.args = [
            "--latest-database-version=true", // [true, false] Use the latest GOA database version. Default: true
            //"--goa-version=\"\"",            // [string] Specify a particular GOA version if latest is set to false.
        ].join(' ')
    }

    // =================================================================
    // PHASE 12: BLAST2GO ANNOTATION
    // =================================================================
    withName: 'GO_ANNOTATION' {
        ext.outdir = '12_blast2go_annotation'
        ext.args = [
            "--annot-cut-off=55",                  // Threshold score: selects the lowest term per branch over this value. Default: 55
            "--go-weight=5",                       // Abstraction factor: weight given to mapped children terms for parent annotation. Default: 5
            //"--species=\"\"",                    // Filter GO by taxonomy: remove terms known not to be in the given taxonomy ID/name.

            // -- Blast Filters --
            "--e-value-hit-filter=1.0E-6",         // Pre-filter: only GO terms from hits with a better e-value will be used. Default: 1.0E-6
            "--hsp-hit-coverage-cutoff=0",         // Minimum alignment coverage percentage required between a Hit and its HSP. Default: 0
            "--hit-filter=500",                    // Considers only the first N hits during annotation. Default: 500
            "--only-hits-with-gos=false",          // [true, false] Applies hit-filter limit only on hits that contain a GO term candidate.

            // -- Computational Analysis Evidence Codes --
            "--ec-iss=0.8",                        // Inferred from Sequence Similarity
            "--ec-iso=0.8",                        // Inferred from Sequence Orthology
            "--ec-isa=0.8",                        // Inferred from Sequence Alignment
            "--ec-ism=0.8",                        // Inferred from Sequence Model
            "--ec-igc=0.7",                        // Inferred from Genomic Context
            "--ec-iba=0.8",                        // Inferred from Biological aspect of Ancestor
            "--ec-ibd=0.8",                        // Inferred from Biological aspect of Descendant
            "--ec-ikr=0.8",                        // Inferred from Key Residues
            "--ec-ird=0.7",                        // Inferred from Rapid Divergence
            "--ec-rca=0.8",                        // Reviewed Computational Analysis

            // -- Experimental Evidence Codes --
            "--ec-ida=1.0",                        // Inferred from Direct Assay
            "--ec-ipi=1.0",                        // Inferred from Physical Interaction
            "--ec-imp=1.0",                        // Inferred from Mutant Phenotype
            "--ec-igi=1.0",                        // Inferred from Genetic Interaction
            "--ec-iep=1.0",                        // Inferred from Expression Pattern
            "--ec-exp=1.0",                        // Inferred from Experiment

            // -- Author Statement Evidence Codes --
            "--ec-tas=0.9",                        // Traceable Author Statement
            "--ec-nas=0.8",                        // Non-traceable Author Statement

            // -- Curator Statement Evidence Codes --
            "--ec-ic=0.9",                         // Inferred by Curator
            "--ec-nd=0.5",                         // No Data available

            // -- Automatically-Assigned Evidence Codes --
            "--ec-iea=0.7",                        // Inferred from Electronic Annotation

            // -- Obsolete Evidence Codes --
            "--ec-nr=0.0"                          // Not Recorded (Obsolete)
        ].join(' ')
    }

    // =================================================================
    // PHASE 13: MERGE InterProScan & GO ANNOTATIONS
    // =================================================================
        withName: 'MERGE_IPS_GOS_TO_ANNOTATION' {
        ext.outdir = '13_merge_ips'
        ext.args = [].join(' ')
    }

}
