// --- FILE: gene_level_analysis.config ---
// Gene-Level Analysis pipeline configuration.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_single_end           = null         // Glob for single-end reads (e.g. 'data/*.fastq.gz')
    input_paired_end           = null         // Glob for paired-end reads (e.g. 'data/*_{1,2}.fastq.gz')
    input_fasta                = null         // Path to reference genome FASTA file
    input_gff                  = null         // Path to genome annotation file (GTF/GFF format)
    experimental_design        = null         // Path to experimental design file (tab-delimited)
    local_folder               = './results'  // Base output directory for all workflow results
    chart_format               = 'box'        // Output chart format: [box, png, pdf, csv]

    // R1/R2 filename patterns for PAIRED-END short reads.
    //upstream_pattern   = '_1'     // R1 filename pattern for PE reads (e.g. '_1' -> sample_1.fastq.gz)
    //downstream_pattern = '_2'     // R2 filename pattern for PE reads (e.g. '_2' -> sample_2.fastq.gz)

    // ---------------------------------------------------
    // STEP-SPECIFIC PARAMETERS
    // ---------------------------------------------------

    trimmomatic {
        adapters = null  // Optional: custom adapter FASTA file for trimming
    }

    fastqc {
        adapters     = null  // Optional: custom adapter FASTA file for QC screening
        contaminants = null  // Optional: custom contaminant FASTA file for QC screening
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: RAW QUALITY CONTROL (PRE-TRIMMING)
    // =================================================================
    withName: 'FASTQC_RAW' {
        ext.outdir = '01_fastqc_raw'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: READ PREPROCESSING & TRIMMING
    // =================================================================
    withName: 'TRIMMOMATIC' {
        ext.outdir = '02_trimmomatic'
        ext.args = [
            "--quality-encoding=auto",               // [auto, phred33, phred64] Auto-detect read quality encoding. Default: auto

            // -- Adapter Removal --
            // "--prefix=trimmed_",   // Output filename prefix.
            // WARNING: --prefix changes the sample names in the count table generated downstream. If enabled, the
            //          differential expression design file MUST use the same prefix, or it fails.
            "--remove-adapters=false",               // [true, false] Enable adapter/contaminant trimming. Default: false
            // "--adapter-options=default",          // [default, custom] Adapter removal strategy (only if remove-adapters=true)
            // "--adapter-list=TruSeq3-SE.fa",       // [TruSeq3-SE.fa, TruSeq2-SE.fa, NexteraPE-PE.fa] Adapter list (only if adapter-options=default)
            // "--seed-mismatches=2",                // Max mismatches for full adapter match (only if remove-adapters=true)
            // "--simple-clip-threshold=15",         // Simple adapter match accuracy threshold (only if remove-adapters=true)
            // "--palindrome-clip-threshold=30",     // PE palindrome clip accuracy threshold (only if remove-adapters=true; PAIRED-END only - OmicsBox errors if set with single-end)

            // -- Paired-End Mode -- (PAIRED-END ONLY, do not enable for single-end input)
            // "--min-adapter-length=8",             // Min detectable adapter length (only if remove-adapters=true; PAIRED-END only - OmicsBox errors if set with single-end)
            // "--keep-both-reads=true",             // Retain reverse read after PE palindrome detection (only if remove-adapters=true; PAIRED-END only - OmicsBox errors if set with single-end)

            // -- Edge Trimming --
            "--edge-trimming=false",                 // [true, false] Enable edge trimming. Default: false
            // "--edge-trimming-options=qual",       // [qual, length] Edge trimming strategy (only if edge-trimming=true)
            // "--qual-trimming-from5p=true",        // Trim low-quality bases from 5' (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold5p=30",   // Min quality threshold at 5' (only if qual-trimming-from5p=true)
            // "--qual-trimming-from3p=true",        // Trim low-quality bases from 3' (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold3p=30",   // Min quality threshold at 3' (only if qual-trimming-from3p=true)
            // "--length-trimming-from5p=false",     // Crop N bases from 5' (only if edge-trimming-options=length)
            // "--length-trimming-threshold5p-remove=3",  // Bases to remove from 5' (only if length-trimming-from5p=true)
            // "--length-trimming-from3p=false",     // Crop to fixed length from 3' (only if edge-trimming-options=length)
            // "--length-trimming-threshold3p-keep=150",  // Bases to keep from start (only if length-trimming-from3p=true)

            // -- Quality Trimming --
            // "--quality-trimming=false",           // [true, false] Enable sliding-window or maxinfo trimming
            // "--quality-trimming-options=sliding", // [sliding, maxinfo] Quality trimming strategy (only if quality-trimming=true)
            // "--window-size=4",                    // Sliding window width (only if quality-trimming-options=sliding)
            // "--required-quality=15",              // Min avg quality in window (only if quality-trimming-options=sliding)
            // "--target-length=40",                 // Target read length for maxinfo (only if quality-trimming-options=maxinfo)
            // "--strictness=0.5",                   // [0..1] Length vs correctness tradeoff (only if quality-trimming-options=maxinfo)

            // -- Quality & Length Filtering --
            "--filter-by-quality=true",              // [true, false] Discard reads below average quality. Default: true
            "--average-quality=25",                  // [integer] Min average quality to retain a read (only if filter-by-quality=true)
            "--filter-by-length=true",               // [true, false] Discard reads below minimum length. Default: true
            "--minimum-length=36"                    // [integer] Minimum retained read length in bp (only if filter-by-length=true)
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: QUALITY CONTROL (POST-TRIMMING)
    // =================================================================
    withName: 'FASTQC_POST' {
        ext.outdir = '03_fastqc_post'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: READ ALIGNMENT TO REFERENCE GENOME
    // =================================================================
    withName: 'STAR' {
        ext.outdir = '04_star'
        ext.args = [
            // -- Annotations --
            "--provide-gff=true",                    // [true, false] Use annotation to improve alignment accuracy. Default: false
            // "--exon-feature-type=exon",           // Feature type in GTF/GFF file to use as exons (only if provide-gff=true)
            "--overhang=100",                        // [integer] Overhang length for splice junction database. Default: 100

            "--two-pass-mode=false",                 // [true, false] Enable 2-pass mapping for sensitive junction discovery. Default: false
            "--sort-by-coordinate=true",             // [true, false] Output coordinate-sorted BAM files. Default: true
            "--align-intron-min=20",                 // [integer] Minimum intron size in bp. Default: 20
            "--align-intron-max=1000000",            // [integer] Maximum intron size in bp. Default: 1000000
            // "--align-mates-gap-max=1000000",         // [integer] Maximum gap between paired-end mates in bp. Default: 1000000 Only allowed for paired-end
            "--out-filter-multimap-nmax=20",         // [integer] Max number of multiple alignments per read. Default: 20
            "--out-filter-mismatch-nmax=999",        // [integer] Max number of mismatches per read. Default: 999
            "--include-chimeric-alignments=false",   // [true, false] Include chimeric alignments in main BAM. Default: false
            "--add-rg=false",                        // [true, false] Include Read Group header in BAM. Default: false
            // "--rg-platform=ILLUMINA",             // [ILLUMINA, IONTORRENT, HELICOS, LS454] Sequencing platform (only if add-rg=true)
            "--save-splice-junctions=true",         // [true, false] Save splice junction coordinates. Default: false
            "--save-unmapped-reads=true"            // [true, false] Save unmapped/partially-mapped reads. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 5: GENE-LEVEL QUANTIFICATION
    // =================================================================
    withName: 'HTSEQ' {
        ext.outdir = '05_htseq'
        ext.args = [
            // -- GFF options --
            "--feature-type=gene",                // Feature type in GTF/GFF (3rd column) for read counting
            "--id-attribute=gene_id",             // GFF attribute type (9th column) to use as feature ID

            "--sequencing-protocols=no",             // [no, yes, reverse] Strand specificity. Default: no
            "--mode=union",                          // [union, intersection-strict, intersection-nonempty] Mode for overlapping reads. Default: union
            "--minaqual=10",                         // [0-100] Minimum MAPQ alignment quality. Default: 10
            "--paired-end-order=name"                // [pos, name] Sort order for paired-end BAM. Default: name
        ].join(' ')
    }

    // =================================================================
    // PHASE 6: STATISTICAL ANALYSIS (PCA)
    // =================================================================
    withName: 'COUNTS_PCA' {
        ext.outdir = '06_counts_pca'
        ext.args = [
            "--design=false",                        // [true, false] Plot PCA with experimental design coloring. Default: false

            // -- Color Options --
            // "--factor=Sample",                    // Experimental factor for PCA coloring (only if design=true)
            // "--paired-factor=Condition",          // Secondary factor for combined coloring (only if design=true)
            // "--combine=false",                    // [true, false] Combine two factors into subgroups (only if design=true)

            "--enable3d=false",                      // [true, false] Enable 3D PCA visualization. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 7: DIFFERENTIAL EXPRESSION ANALYSIS
    // =================================================================
   withName: 'EDGER' {
        ext.outdir = '07_edger'
        ext.args = [
            // -- Filter Genes with low counts --
            "--filtering-mode=cpm",               // [cpm, raw] Filtering mode. WARNING: raw disables --cpm-filter and --minimum-samples (comment those out if you set raw). Default: cpm
            "--cpm-filter=1.0",                      // [0.0-10.0] CPM filter threshold for low-count genes. Default: 1.0
            "--minimum-samples=2",                   // [0-100] Min samples above CPM filter. Default: 2

            // -- Calculate normalization factors to scale the raw library sizes --
            "--norm-method=TMM",                     // [TMM, TMMwsp, RLE, upperquartile, none] Normalization method. Default: TMM

            // -- Design Type --
            "--design-type=Simple",                  // [Simple, Multi, Paired] Design type for analysis. Default: Simple

            // -- Primary Target --
            //"--primary-experimental-factor=Condition",      // Primary experimental factor for comparison (only if design-type is set)
            //"--primary-contrast-condition=Treatment",       // Contrast condition (only if design-type is set)
            //"--primary-reference-condition=Control",        // Reference condition (only if design-type is set)

            // -- Secondary Target --
            // "--secondary-experimental-factor=Batch",        // Secondary factor for Paired/Multi designs (only if applicable)
            // "--secondary-contrast-condition=BatchB",        // Secondary contrast condition (only if applicable)
            // "--secondary-reference-condition=BatchA",       // Secondary reference condition (only if applicable)

            // -- Statistical Test --
            "--test-type=Exact",                  // [Exact, GLM_LRT, GLM_QL] Statistical test. Exact ONLY for Simple design. Default: Exact
            "--robust=true",                      // [true, false] Robust estimation against outlier features. Default: true

            // "--delimiter=tab",                    // [tab, space, comma, semicolon] Column separator (only if count table is plain-text via --i-count-table-file). Default: tab
            // "--na-treatment=skip",                // [skip, zero] NA handling (only if plain-text count table). Default: skip
        ].join(' ')
    }

}
