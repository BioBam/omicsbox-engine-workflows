// --- FILE: functional_annotation.config ---

params {
    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    local_folder   = './results'
    input_fasta    = null  // Path to the input multi-FASTA file
    chart_format   = 'box' // Output chart format for all chart processes: [box, png, pdf, csv]

    // ---------------------------------------------------
    // STEP-SPECIFIC PARAMETERS
    // ---------------------------------------------------

    goslim {
        // Optional custom GO-Slim OBO file -> injected by the module as --i-go-slim-obo-file (only if set).
        // REQUIRED when the GO_SLIM step uses --option=custom (see the GO_SLIM ext.args block below): with 'custom'
        // OmicsBox disables --go-slim-web-file and expects this OBO file instead. Leave null for --option=web.
        obo_file = null
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: INITIALIZATION & PROJECT SETUP
    // =================================================================
    withName: 'LOAD_FASTA' {
        ext.outdir = '01_load_fasta'
        ext.args = [
            "--handle-double-ids=replace", // [skip, replace, add_with_new_id] Decide what to do with duplicated sequence IDs. Default: replace
            "--add-description=true"       // [true, false] Add everything after first whitespace in header as description. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: SEQUENCE HOMOLOGY & GO MAPPING
    // =================================================================
    withName: 'DIAMOND_BLAST' {
        ext.outdir = '02_diamond_blast'
        ext.args = [
            "--blast-mode=blastx",         // [blastx, blastp] Default: blastx
            "--sensitivity=more_sensitive",// [fast, mid_sensitive, standard, sensitive, more_sensitive, very_sensitive]
            "--database=swissprot_20250925",      // Target BLAST database: [refseq_protein_20250925, refseq_227_20241120, refseq_224_20240711, refseq_223_20240411, refseq_221_20240109, refseq_220_20230921, refseq_216_20230201, nr_20250925, nr_20241120, nr_20240711, nr_20240411, nr_20240109, nr_20230921, nr_20230201, swissprot_20250925, swissprot_20241120, swissprot_20240711, swissprot_20240411, swissprot_20240109, swissprot_20230921, swissprot_20230201]

            // -- Target Database --
            //"--species=9606",              // Specify taxonomies to blast against (comma-separated string).
            "--taxa-filter-option=included", // ["included", "excluded"] Use the taxonomy id list to either include or exclude the selected taxonomies.

            "--blast-expect-value=1.0E-3", // [1000, 10, 5, 1, 0.1, 1.0E-3, 1.0E-5, ...] Default: 1.0E-3
            // "--long-queries=false",        // Set to true to optimize for long sequences (>30 kbp). Only allowed with blastx.
            "--number-of-hits=20",         // [integer] Default: 20
            "--blast-min-hsplength=33",    // [integer] Default: 33
            "--hsp-hit-coverage-cutoff=0", // [integer] Default: 0
        ].join(' ')
    }

    withName: 'BLAST_CHARTS' {
        ext.outdir = '02_blast_charts'
        ext.args = [
            "--blast-evalue-distribution=true",
            "--blast-similarity-distribution=true",
            "--blast-species-distribution=true",
            "--blast-top-hit-distribution=true",
            "--blast-hsp-hit-coverage-distribution=true",
            "--blast-hsp-seq-distribution=true",
            "--blast-hsp-distribution=true",
            "--blast-hit-distribution=true"   // [true, false] Default: false
        ].join(' ')
    }

    withName: 'GO_MAPPING' {
        ext.outdir = '03_go_mapping'
        ext.args = [
            "--latest-database-version=true", // [true, false] Use the latest GOA database version. Default: true
            //"--goa-version=\"\"",            // [string] Specify a particular GOA version if latest is set to false.
        ].join(' ')
    }

    withName: 'GO_MAPPING_CHARTS' {
        ext.outdir = '03_go_mapping_charts'
        ext.args = [
            "--mapping-go-mapping-distribution=true",                      // [true, false] Default: true
            "--mapping-evidence-code-distribution-for-sequences=true",     // [true, false] Default: true
            "--mapping-evidence-code-distribution-for-blast-hits=true"     // [true, false] Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: BLAST2GO ANNOTATION
    // =================================================================
    withName: 'GO_ANNOTATION' {
        ext.outdir = '04_go_annotation'
        ext.args = [
            "--annot-cut-off=55",                  // Threshold score: selects the lowest term per branch over this value. Default: 55
            "--go-weight=5",                       // Abstraction factor: weight given to mapped children terms for parent annotation. Default: 5
            //"--species=\"\"",                    // Filter GO by taxonomy: remove terms known not to be in the given taxonomy ID/name.

            // -- Blast Filters --
            "--e-value-hit-filter=1.0E-6",         // Pre-filter: only GO terms from hits with a better e-value will be used. Default: 1.0E-6
            "--hsp-hit-coverage-cutoff=0",         // Minimum alignment coverage percentage required between a Hit and its HSP. Default: 0
            "--hit-filter=500",                    // Considers only the first N hits during annotation. Default: 500
            "--only-hits-with-gos=false",          // [true, false] Applies hit-filter limit only on hits that contain a GO term candidate.

            // -- Computational Analysis Evidence Codes --
            "--ec-iss=0.8",                        // Inferred from Sequence Similarity
            "--ec-iso=0.8",                        // Inferred from Sequence Orthology
            "--ec-isa=0.8",                        // Inferred from Sequence Alignment
            "--ec-ism=0.8",                        // Inferred from Sequence Model
            "--ec-igc=0.7",                        // Inferred from Genomic Context
            "--ec-iba=0.8",                        // Inferred from Biological aspect of Ancestor
            "--ec-ibd=0.8",                        // Inferred from Biological aspect of Descendant
            "--ec-ikr=0.8",                        // Inferred from Key Residues
            "--ec-ird=0.7",                        // Inferred from Rapid Divergence
            "--ec-rca=0.8",                        // Reviewed Computational Analysis

            // -- Experimental Evidence Codes --
            "--ec-ida=1.0",                        // Inferred from Direct Assay
            "--ec-ipi=1.0",                        // Inferred from Physical Interaction
            "--ec-imp=1.0",                        // Inferred from Mutant Phenotype
            "--ec-igi=1.0",                        // Inferred from Genetic Interaction
            "--ec-iep=1.0",                        // Inferred from Expression Pattern
            "--ec-exp=1.0",                        // Inferred from Experiment

            // -- Author Statement Evidence Codes --
            "--ec-tas=0.9",                        // Traceable Author Statement
            "--ec-nas=0.8",                        // Non-traceable Author Statement

            // -- Curator Statement Evidence Codes --
            "--ec-ic=0.9",                         // Inferred by Curator
            "--ec-nd=0.5",                         // No Data available

            // -- Automatically-Assigned Evidence Codes --
            "--ec-iea=0.7",                        // Inferred from Electronic Annotation

            // -- Obsolete Evidence Codes --
            "--ec-nr=0.0"                          // Not Recorded (Obsolete)
        ].join(' ')
    }

    withName: 'BLAST2GO_ANNOTATION_CHARTS' {
        ext.outdir = '04_blast2go_annotation_charts'
        ext.args = [
            "--annotation-distribution=true",                              // [true, false] Default: true
            "--go-annotation-level-distribution=true",                     // [true, false] Default: false
            "--annotation-score-distribution=true",                        // [true, false] Default: false
            "--relation-seq-length-annots-statistics-relative=true",       // [true, false] Annotated Seqs/Seq-Length. Default: false
            "--relation-seq-length-annots-statistics-absolute=true",       // [true, false] Number of GOs/Seq-Length. Default: false
            "--go-distribution-by-level=true",                             // [true, false] Default: false
            //"--ontology-level=2",                                          // [integer] GO level for distribution chart. Default: 2

            // -- Direct GO Count --
            "--go-distribution-mf=true",                                   // [true, false] Molecular Function. Default: false
            "--go-distribution-bp=true",                                   // [true, false] Biological Process. Default: false
            "--go-distribution-cc=true",                                   // [true, false] Cellular Component. Default: false

            // -- EC-Code Statistics --
            // Turn off EC distribution at this early stage since InterPro/EggNOG are not merged yet.
            // EC codes are derived in EC_CODE_MAPPING (phase 6), after COMBINE_PROJECTS and the
            // InterPro/EggNOG merges, so charting them here would report on incomplete data.
            // The full EC breakdown is enabled in FINAL_ANNOTATION_CHARTS instead.
            "--main-level=false",                                         // [true, false] Main Enzyme Classes. Default: false
            "--oxidoreductases=false",                                    // [true, false] Default: false
            "--transferases=false",                                       // [true, false] Default: false
            "--hydrolases=false",                                         // [true, false] Default: false
            "--lyases=false",                                             // [true, false] Default: false
            "--isomerases=false",                                         // [true, false] Default: false
            "--ligases=false",                                            // [true, false] Default: false
            "--translocases=false"                                        // [true, false] Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: PARALLEL DOMAIN & ORTHOLOGY PREDICTION
    // =================================================================
    withName: 'INTERPROSCAN' {
        ext.outdir = '05_interproscan'
        ext.args = [
            // -- Families, Domains, Sites and Repeats --
            "--ncbi-fam=true",          // [true, false] NCBIfam member database. Default: true
            "--sfld=true",              // [true, false] SFLD member database. Default: true
            "--hmm-panther=true",       // [true, false] PANTHER member database. Default: true
            "--hamap=true",             // [true, false] HAMAP member database. Default: true
            "--profile-scan=true",      // [true, false] ProfileScan member database. Default: true
            "--pattern-scan=false",     // [true, false] PatternScan member database. Default: false
            "--cdd=true",               // [true, false] CDD member database. Default: true
            "--f-print-scan=true",      // [true, false] FPrintScan member database. Default: true
            "--hmmpfam=true",           // [true, false] HMMER/Pfam member database. Default: true
            "--pirsf=true",             // [true, false] PIRSF member database. Default: true

            // -- Structural Domains --
            "--super-family=true",      // [true, false] SUPERFAMILY member database. Default: true
            "--gene3d=true",            // [true, false] Gene3D member database. Default: true

            // -- Other Sequence Features --
            "--coils=false",            // [true, false] Coils member database. Default: false

            // -- Other Categories --
            "--anti-fam=true",          // [true, false] AntiFam member database. Default: true
            "--fun-fam=true",           // [true, false] FunFam member database. Default: true
            "--pirsr=true",             // [true, false] PIRSR member database. Default: true

            "--export-format=xml,gff3"  // [xml, gff3, tsv, ...] Output export formats. Default: xml,gff3
        ].join(' ')
    }

    withName: 'IPS_CHARTS' {
        ext.outdir = '05_ips_charts'
        ext.args = [
            "--interpro-results=true",        // [true, false] Generate InterPro Results chart. Default: true
            "--interpro-families=true",       // [true, false] Generate InterPro Families chart. Default: true
            "--interpro-domains=true",        // [true, false] Generate InterPro Domains chart. Default: false
            "--interpro-repeats=true",        // [true, false] Generate InterPro Repeats chart. Default: false
            "--interpro-sites=true",          // [true, false] Generate InterPro Sites chart. Default: false
            "--interpro-ids=true",            // [true, false] Generate InterPro IDs chart. Default: false
            "--interpro-by-application=true", // [true, false] Group charts by application. Default: false
            "--application=Pfam"              // [BlastProDom, FPrintScan, PIR, Pfam, Smart, Tigr, ProfileScan, HAMAP, SuperFamily, Panther, Gene3D]
                                              // Application filter for the by-application chart. Default: BlastProDom.
                                              // Set to 'Pfam' to match --hmmpfam=true in INTERPROSCAN above: the
                                              // BlastProDom default has no corresponding member-database switch in
                                              // that step, so the chart would be built from an application that was
                                              // never run and would come out empty.
        ].join(' ')
    }

    withName: 'EGGNOG_MAPPER' {
        ext.outdir = '06_eggnog_mapper'
        ext.args = [
            "--i-type-options=genes",          // [cds, genes, proteins] Input sequence type. Default: genes

            // -- Annotation Options --
            "--taxonomic-scope=auto",          // [auto, ...] Taxonomic scope for annotation. Default: auto
            "--target-orthologs=all",          // [all, one2one, many2one, one2many, many2many] Default: all
            "--go-evidence=non-electronic",    // [experimental, non-electronic] GO evidence type filter. Default: non-electronic

            // -- Search Filters --
            "--blast-expect-value=1.0E-3"      // E-value threshold for BLAST. Default: 1.0E-3
        ].join(' ')
    }

    // =================================================================
    // PHASE 5: COMBINE BLAST WITH INTERPRO AND EGGNOG RESULTS
    // =================================================================
    withName: 'COMBINE_PROJECTS' {
        ext.outdir = '07_combine_projects'
        ext.args = [
            "--merge-sequence-data=add",        // [add, skip, replace] Add sequences if they do not exist. Default: add
            "--merge-sequence-description=add", // [add, skip, replace] Merge headers/descriptions. Default: add
            "--merge-blast-go-mapping=add",     // [add, skip, replace] Merge candidate GO mappings. Default: add
            "--merge-go-annotation=add",        // [add, skip, replace] Merge functional GO terms. Default: add
            "--merge-ips-annotation=add",       // [add, skip, replace] Merge InterPro domain terms. Default: add
            "--main-project=project1"           // [project1, project2] Define priority project layout. Default: project1
        ].join(' ')
    }

    withName: 'MERGE_IPS_GOS_TO_ANNOTATION' {
        ext.outdir = '08_merge_ips'
        ext.args = [].join(' ')
    }

    withName: 'MERGE_EGGNOG_5_GOS' {
        ext.outdir = '09_merge_eggnog'
        ext.args = [
            "--evalue-filter=10",       // Discard protein match alignments with a higher E-Value. Default: 10
            "--bit-score-filter=10.0"   // Discard protein match alignments with a lower bit-score. Default: 10.0
        ].join(' ')
    }

    // =================================================================
    // PHASE 6: FINAL CURATION, EC MAPPING & REPORTING
    // =================================================================
    withName: 'VALIDATE_GO_ANNOTATION' {
        ext.outdir = '10_validate_go'
        ext.args = [].join(' ')
    }

    withName: 'EC_CODE_MAPPING' {
        ext.outdir = '11_ec_code_mapping'
        ext.args = [].join(' ') // No configurable parameters.
    }

    withName: 'FINAL_ANNOTATION_CHARTS' {
        ext.outdir = '12_final_annotation_charts'
        ext.args = [
            "--annotation-distribution=true",                              // [true, false] Default: true
            "--go-annotation-level-distribution=true",                     // [true, false] Default: false
            "--annotation-score-distribution=true",                        // [true, false] Default: false
            "--relation-seq-length-annots-statistics-relative=true",       // [true, false] Annotated Seqs/Seq-Length. Default: false
            "--relation-seq-length-annots-statistics-absolute=true",       // [true, false] Number of GOs/Seq-Length. Default: false
            "--go-distribution-by-level=true",                             // [true, false] Default: false
            //"--ontology-level=2",                                          // [integer] GO level for distribution chart. Default: 2

            // -- Direct GO Count --
            "--go-distribution-mf=true",                                   // [true, false] Molecular Function. Default: true
            "--go-distribution-bp=true",                                   // [true, false] Biological Process. Default: true
            "--go-distribution-cc=true",                                   // [true, false] Cellular Component. Default: true

            // -- EC-Code Statistics --
            // Full functional data is now integrated; enable all EC distribution charts
            "--main-level=true",                                           // [true, false] Main Enzyme Classes. Default: true
            "--oxidoreductases=true",                                      // [true, false] Default: false
            "--transferases=true",                                         // [true, false] Default: false
            "--hydrolases=true",                                           // [true, false] Default: false
            "--lyases=true",                                               // [true, false] Default: false
            "--isomerases=true",                                           // [true, false] Default: false
            "--ligases=true",                                              // [true, false] Default: false
            "--translocases=true"                                          // [true, false] Default: false
        ].join(' ')
    }

    withName: 'PROJECT_CHARTS' {
        ext.outdir = '12_project_charts'
        ext.args = [
            "--data-distribution=true",           // [true, false] Generate data distribution chart. Default: true
            "--data-distribution-pie-chart=true", // [true, false] Generate data distribution pie chart. Default: false
            "--analysis-progress=true",           // [true, false] Generate analysis progress chart. Default: false
            "--seq-length=true"                   // [true, false] Generate sequence length distribution chart. Default: false
        ].join(' ')
    }

    withName: 'COMBINED_GO_GRAPH' {
        ext.outdir = '12_combined_go_graph'
        ext.args = [
            "--title=\"Combined GO Graph Analysis\"",                        // Graph title. Default: "Combined Graph"
            "--go-categories=\"biological_process,molecular_function,cellular_component\"" // GO ontology categories to include.
        ].join(' ')
    }

    withName: 'EXPORT_GENE_SETS' {
        ext.outdir = '12_export_genesets'
        ext.args = [
            "--propagated=false" // [true, false] Export propagated annotations. Default: false (direct only)
        ].join(' ')
    }

    withName: 'GO_SLIM' {
        ext.outdir = '13_go_slim'
        ext.args = [
            "--option=web",              // [web, custom] Source for the GO-Slim OBO file. Default: web.
                                         // If set to 'custom': COMMENT OUT --go-slim-web-file below (custom disables it) and
                                         // provide your OBO file via params.goslim.obo_file.
            "--go-slim-web-file=generic" // [generic, plant, candida, yeast, protein, pombe, aspergillus, metagenomics, agr, chembl, drosophila, mouse, prokaryote, synapse, virus, ...] GO-Slim subset. Default: generic. (Only when --option=web.)
        ].join(' ')
    }

    withName: 'GOSLIM_ANNOTATION_CHARTS' {
        ext.outdir = '13_goslim_charts'
        // Reuses the statistics-annotation module; tailored for the GO Slim project.
        ext.args = [
            "--annotation-distribution=true",                              // [true, false] Default: true
            "--go-annotation-level-distribution=true",                     // [true, false] Default: false
            "--annotation-score-distribution=true",                        // [true, false] Default: false
            "--relation-seq-length-annots-statistics-relative=true",       // [true, false] Annotated Seqs/Seq-Length. Default: false
            "--relation-seq-length-annots-statistics-absolute=true",       // [true, false] Number of GOs/Seq-Length. Default: false
            "--go-distribution-by-level=true",                             // [true, false] Default: false
            //"--ontology-level=2",                                          // [integer] GO level for distribution chart. Default: 2

            // -- Direct GO Count --
            "--go-distribution-mf=true",                                   // [true, false] Molecular Function. Default: true
            "--go-distribution-bp=true",                                   // [true, false] Biological Process. Default: true
            "--go-distribution-cc=true",                                   // [true, false] Cellular Component. Default: true

            // -- EC-Code Statistics --
            // Full functional data is now integrated; enable all EC distribution charts
            "--main-level=true",                                           // [true, false] Main Enzyme Classes. Default: true
            "--oxidoreductases=true",                                      // [true, false] Default: false
            "--transferases=true",                                         // [true, false] Default: false
            "--hydrolases=true",                                           // [true, false] Default: false
            "--lyases=true",                                               // [true, false] Default: false
            "--isomerases=true",                                           // [true, false] Default: false
            "--ligases=true",                                              // [true, false] Default: false
            "--translocases=true"                                          // [true, false] Default: false
        ].join(' ')
    }

}
