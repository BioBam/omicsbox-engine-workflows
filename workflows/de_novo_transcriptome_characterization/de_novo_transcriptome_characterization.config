// --- FILE: de_novo_transcriptome_characterization.config ---
// De Novo Transcriptome Characterization & Functional Annotation pipeline.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_single_end = null         // Glob for single-end reads (e.g. 'data/*.fastq.gz')
    input_paired_end = null         // Glob for paired-end reads (e.g. 'data/*_{1,2}.fastq.gz')
    local_folder     = './results'  // Base output directory for all workflow results
    cloud_folder     = null         // Cloud storage path for WJOB_ASYNC tools (e.g. 's3://my-bucket/omicsbox-outputs/')
    chart_format     = 'box'        // Output chart format: [box, png, pdf, csv]

    // ---------------------------------------------------
    // INPUT-SPECIFIC PARAMETERS
    // ---------------------------------------------------
    //upstream_pattern   = '_1'     // R1 filename pattern for PE reads (e.g. '_1' → sample_1.fastq.gz)
    //downstream_pattern = '_2'     // R2 filename pattern for PE reads (e.g. '_2' → sample_2.fastq.gz)

    trimmomatic {
        adapters = null  // Optional: custom adapter FASTA file for trimming
    }

    fastqc {
        adapters     = null  // Optional: custom adapter FASTA file for QC screening
        contaminants = null  // Optional: custom contaminant FASTA file for QC screening
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------

process {

    // =================================================================
    // PHASE 1: QUALITY CONTROL (PRE-TRIMMING)
    // =================================================================
    withName: 'FASTQC_RAW' {
        ext.outdir = '01_fastqc_raw'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: PREPROCESSING & READ TRIMMING
    // =================================================================
    withName: 'TRIMMOMATIC' {
        ext.outdir = '02_trimmomatic'
        ext.args = [
            "--quality-encoding=auto",               // [auto, phred33, phred64] Auto-detect read quality encoding. Default: auto
            // "--prefix=trimmed_",                  // Output filename prefix
            "--remove-adapters=false",               // [true, false] Enable adapter/contaminant trimming. Default: false
            // "--adapter-options=default",          // [default, custom] Adapter removal strategy (only if remove-adapters=true)
            // "--adapter-list=TruSeq3-SE.fa",       // [TruSeq3-SE.fa, TruSeq2-SE.fa, NexteraPE-PE.fa] Adapter list (only if adapter-options=default)
            // "--seed-mismatches=2",                // Max mismatches for full adapter match (only if remove-adapters=true)
            // "--palindrome-clip-threshold=30",     // PE palindrome clip accuracy threshold (only if remove-adapters=true)
            // "--simple-clip-threshold=15",         // Simple adapter match accuracy threshold (only if remove-adapters=true)
            // "--min-adapter-length=8",             // Min detectable adapter length (only if remove-adapters=true)
            // "--keep-both-reads=true",             // Retain reverse read after PE palindrome detection (only if remove-adapters=true)
            "--edge-trimming=false",                 // [true, false] Enable edge trimming. Default: false
            // "--edge-trimming-options=qual",       // [qual, length] Edge trimming strategy (only if edge-trimming=true)
            // "--qual-trimming-from5p=true",        // Trim low-quality bases from 5' (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold5p=30",   // Min quality threshold at 5' (only if qual-trimming-from5p=true)
            // "--qual-trimming-from3p=true",        // Trim low-quality bases from 3' (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold3p=30",   // Min quality threshold at 3' (only if qual-trimming-from3p=true)
            // "--length-trimming-from5p=false",     // Crop N bases from 5' (only if edge-trimming-options=length)
            // "--length-trimming-threshold5p-remove=3",  // Bases to remove from 5' (only if length-trimming-from5p=true)
            // "--length-trimming-from3p=false",     // Crop to fixed length from 3' (only if edge-trimming-options=length)
            // "--length-trimming-threshold3p-keep=150",  // Bases to keep from start (only if length-trimming-from3p=true)
            // "--quality-trimming=false",           // [true, false] Enable sliding-window or maxinfo trimming
            // "--quality-trimming-options=sliding", // [sliding, maxinfo] Quality trimming strategy (only if quality-trimming=true)
            // "--window-size=4",                    // Sliding window width (only if quality-trimming-options=sliding)
            // "--required-quality=15",              // Min avg quality in window (only if quality-trimming-options=sliding)
            // "--target-length=40",                 // Target read length for maxinfo (only if quality-trimming-options=maxinfo)
            // "--strictness=0.5",                   // [0..1] Length vs correctness tradeoff (only if quality-trimming-options=maxinfo)
            "--filter-by-quality=true",              // [true, false] Discard reads below average quality. Default: true
            "--average-quality=25",                  // [integer] Min average quality to retain a read (only if filter-by-quality=true)
            "--filter-by-length=true",               // [true, false] Discard reads below minimum length. Default: true
            "--minimum-length=36"                    // [integer] Minimum retained read length in bp (only if filter-by-length=true)
        ].join(' ')
    }

    withName: 'FASTQC_POST' {
        ext.outdir = '03_fastqc_post'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: DE NOVO ASSEMBLY & CLUSTERING
    // =================================================================
    withName: 'TRINITY' {
        ext.outdir = '04_trinity'
        ext.args = [
            // --sequencing is injected dynamically (Single/Paired) in the module
            "--seq-type=fq",                         // [fq, fa] Input read type. Default: fq
            "--strand-specificity=NO",               // [NO, F, R] Library strandedness. Default: NO
            "--min-contig-length=800",               // [integer] Min assembled contig length (bp). Default: 200
            "--get-read-representation=false",       // [true, false] Align reads back to assembly with Bowtie2. Default: false
            "--get-super-transcripts=false",         // [true, false] Generate SuperTranscript collapsed gene models. Default: false
            "--no-normalize-reads=false",            // [true, false] false = use normalization (recommended). Default: false
            "--norm-max-read-cov=200",               // [integer] Max read coverage after normalization. Default: 200
            "--min-fused-transcripts=false",         // [true, false] Minimize fusion transcripts (compact genomes). Default: false
            // "--pairs-distance=500",               // [integer] Max PE fragment size (bp) (only if sequencing=Paired)
            "--min-kmer-cov=2",                      // [integer] Min k-mer coverage for Inchworm assembly. Default: 2
            "--max-reads-per-graph=200000",          // [integer] Max reads per Chrysalis de Bruijn graph. Default: 200000
            "--min-glue=2",                          // [integer] Min reads to glue Inchworm contigs. Default: 2
            "--max-cluster-size=25",                 // [integer] Max Inchworm contigs per Chrysalis cluster. Default: 25
            "--bfly-algorithm=ORIGINAL",             // [ORIGINAL, PASAFLY] Butterfly assembly algorithm. Default: ORIGINAL
            "--path-reinforcement-dist=25",          // [integer] Min read overlap with transcript path. Default: 25
            "--no-path-merging=false",               // [true, false] false = merge near-identical paths. Default: false
            "--min-per-id-same-path=98",             // [0-100] Min % identity to merge paths. Default: 98
            "--max-diffs-same-path=2",               // [integer] Max base differences between merged paths. Default: 2
            "--max-internal-gap-same-path=10"        // [integer] Max internal consecutive gaps in merged paths. Default: 10
        ].join(' ')
    }

    withName: 'CDHIT' {
        ext.outdir = '05_cdhit'
        ext.args = [
            "--sequence-identity-type=global",       // [global, local] Identity calculation basis. Default: global
            "--sequence-identity=0.95",              // [0.8-1.0] Sequence identity threshold. Default: 0.95
            "--band-width=20",                       // [integer] Alignment band width. Default: 20
            "--word-length=10",                      // [2-11] Word size for matching. Default: 10
            "--length-cutoff=10",                    // [integer] Skip sequences shorter than this (bp). Default: 10
            "--length-difference-cutoff=0.0",        // [0-1] Min length ratio of shorter to representative. Default: 0.0
            "--accurate-mode=false",                 // [true, false] true = most similar; false = first-match. Default: false
            "--strand=true",                         // [true, false] true = both +/+ and +/-; false = +/+ only. Default: true
            "--set-alignment-coverage-longer=false", // [true, false] Enable coverage cutoff for longer sequence. Default: false
            // "--alignment-coverage-longer=0.9",   // [0-1] Coverage fraction for longer seq (only if set-alignment-coverage-longer=true)
            "--set-alignment-coverage-shorter=false",// [true, false] Enable coverage cutoff for shorter sequence. Default: false
            // "--alignment-coverage-shorter=0.9",  // [0-1] Coverage fraction for shorter seq (only if set-alignment-coverage-shorter=true)
            "--max-unmatched-percentage-longer=1.0", // [0-1] Max unmatched % for longer sequence. Default: 1.0
            "--max-unmatched-percentage-shorter=1.0",// [0-1] Max unmatched % for shorter sequence. Default: 1.0
            "--alignment-position-constrains=false", // [true, false] Force alignment at sequence beginnings. Default: false
            "--save-clusters=true"                   // [true, false] Save cluster membership file alongside FASTA. Default: true
        ].join(' ')
    }

    withName: 'BUSCO' {
        ext.outdir = '06_busco'
        ext.args = [
            '--blast-expect-value=1e-03',           // [1e-3..1e-100] E-value cutoff for BUSCO BLAST. Default: 1e-03
            '--mode=transcriptome',                 // [transcriptome, genome, proteins] Assessment mode. Default: transcriptome
            '--lineage=eukaryota',                  // BUSCO lineage dataset — SET to your organism's clade. Default: eukaryota
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: ORF PREDICTION & PROJECT INITIALIZATION
    // =================================================================
    withName: 'TRANSDECODER' {
        ext.outdir = '07_transdecoder'
        ext.args = [
            "--genetic-code=Universal",              // [Universal, Candida, Ciliate, ...] Genetic code table. Default: Universal
            "--minimum-length=100",                  // [integer] Min protein length (aa). Default: 100
            "--strand-specific=false",               // [true, false] Only analyze top strand. Default: false
            "--pfam=false",                          // [true, false] Use Pfam domain searches to identify ORFs. Default: false
            "--retain-long-orfs-mode=dynamic",       // [dynamic, strict] ORF retention mode. Default: dynamic
            // "--retain-long-orfs-length=1000000", // [integer] Min ORF length in strict mode (only if retain-long-orfs-mode=strict)
            "--single-best-only=false",              // [true, false] Retain only single best ORF per transcript. Default: false
            "--no-refine-starts=false",              // [true, false] false = refine start codons via PWM. Default: false
            "--top-longest-orfs=500"                 // [integer] Top longest ORFs for Markov model training. Default: 500
        ].join(' ')
    }

    withName: 'LOAD_FASTA' {
        ext.outdir = '08_load_fasta'
        ext.args = [
            "--handle-double-ids=replace",   // [skip, replace, add_with_new_id] Handle duplicated sequence IDs. Default: replace
            "--add-description=true"         // [true, false] Add everything after first whitespace as description. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 5: PARALLEL FUNCTIONAL ANNOTATION
    // =================================================================
    withName: 'DIAMOND_BLAST' {
        ext.outdir = '09_diamond_blast'
        ext.args = [
            // "--species=9606",                    // Specify taxonomies to blast against (comma-separated string)
            "--blast-mode=blastp",                   // [blastx, blastp] BLAST search mode. Default: blastx
            "--database=nr_20250925",                // Target BLAST database. Default: nr_20250925
            "--sensitivity=more_sensitive",          // [fast, mid_sensitive, standard, sensitive, more_sensitive, very_sensitive, ultra_sensitive]
            "--blast-expect-value=1.0E-3",           // [1.0E-10 to 1000] E-value threshold. Default: 1.0E-3
            "--number-of-hits=20",                   // [integer] Number of hits to report. Default: 20
            "--blast-min-hsplength=33",              // [integer] Minimum HSP length. Default: 33
            "--hsp-hit-coverage-cutoff=0",           // [integer] HSP hit coverage cutoff. Default: 0
            "--long-queries=false",                  // [true, false] Optimize for long sequences (>30 kbp). Default: false
            "--taxa-filter-option=\"Include only the selected taxonomies in the search\""  // Include or exclude selected taxonomies
        ].join(' ')
    }

    withName: 'BLAST_CHARTS' {
        ext.outdir = '09_blast_charts'
        ext.args = [
            "--blast-evalue-distribution=true",      // [true, false] E-value distribution chart. Default: true
            "--blast-similarity-distribution=false", // [true, false] Similarity distribution chart. Default: false
            "--blast-species-distribution=false",    // [true, false] Species distribution chart. Default: false
            "--blast-top-hit-distribution=true",     // [true, false] Top hit distribution chart. Default: true
            "--blast-hsp-hit-coverage-distribution=false",  // [true, false] HSP hit coverage chart. Default: false
            "--blast-hsp-seq-distribution=false",    // [true, false] HSP sequence distribution chart. Default: false
            "--blast-hsp-distribution=false",        // [true, false] HSP distribution chart. Default: false
            "--blast-hit-distribution=false"         // [true, false] Hit distribution chart. Default: false
        ].join(' ')
    }

    withName: 'INTERPROSCAN' {
        ext.outdir = '10_interproscan'
        ext.args = [
            "--anti-fam=true",                       // [true, false] AntiFam member database. Default: true
            "--f-print-scan=true",                   // [true, false] FPrintScan member database. Default: true
            "--hmmpfam=true",                        // [true, false] HMMER/Pfam member database. Default: true
            "--fun-fam=true",                        // [true, false] FunFam member database. Default: true
            "--profile-scan=true",                   // [true, false] ProfileScan member database. Default: true
            "--hamap=true",                          // [true, false] HAMAP member database. Default: true
            "--pattern-scan=false",                  // [true, false] PatternScan member database. Default: false
            "--super-family=true",                   // [true, false] SUPERFAMILY member database. Default: true
            "--hmm-panther=true",                    // [true, false] PANTHER member database. Default: true
            "--gene3d=true",                         // [true, false] Gene3D member database. Default: true
            "--coils=false",                         // [true, false] Coils member database. Default: false
            "--cdd=true",                            // [true, false] CDD member database. Default: true
            "--sfld=true",                           // [true, false] SFLD member database. Default: true
            "--pirsr=true",                          // [true, false] PIRSR member database. Default: true
            "--pirsf=true",                          // [true, false] PIRSF member database. Default: true
            "--ncbi-fam=true",                       // [true, false] NCBIfam member database. Default: true
            "--export-format=xml,gff3"               // [xml, gff3, tsv, ...] Output export formats. Default: xml,gff3
        ].join(' ')
    }

    withName: 'IPS_CHARTS' {
        ext.outdir = '05_ips_charts'
        ext.args = [
            "--interpro-results=true",        // [true, false] Generate InterPro Results chart. Default: true
            "--interpro-families=true",       // [true, false] Generate InterPro Families chart. Default: true
            "--interpro-domains=false",        // [true, false] Generate InterPro Domains chart. Default: false
            "--interpro-repeats=false",        // [true, false] Generate InterPro Repeats chart. Default: false
            "--interpro-sites=false",          // [true, false] Generate InterPro Sites chart. Default: false
            "--interpro-ids=false",            // [true, false] Generate InterPro IDs chart. Default: false
            "--interpro-by-application=false", // [true, false] Group charts by application. Default: false
            //"--application=BlastProDom"             // Application filter for by-application chart. Default: BlastProDom
        ].join(' ')
    }

    withName: 'EGGNOG_MAPPER' {
        ext.outdir = '11_eggnog_mapper'
        ext.args = [
            "--taxonomic-scope=auto",                // [auto, taxonomy-id] Taxonomic scope for annotation. Default: auto
            "--target-orthologs=all",                // [all, one2one, many2one, one2many, many2many] Default: all
            "--go-evidence=non-electronic",          // [non-electronic, all] GO evidence type filter. Default: non-electronic
            "--i-type-options=proteins",             // [cds, genes, proteins] Input sequence type. Default: genes
            "--blast-expect-value=1.0E-3"            // [1.0E-10 to 1000] E-value threshold. Default: 1.0E-3
        ].join(' ')
    }

    // =================================================================
    // PHASE 6: ANNOTATION CONSOLIDATION
    // =================================================================
    withName: 'COMBINE_PROJECTS' {
        ext.outdir = '12_combine_projects'
        ext.args = [
            "--merge-sequence-data=add",             // [add, skip, replace] Merge sequence data. Default: add
            "--merge-sequence-description=add",      // [add, skip, replace] Merge headers/descriptions. Default: add
            "--merge-blast-go-mapping=add",          // [add, skip, replace] Merge GO mappings. Default: add
            "--merge-go-annotation=add",             // [add, skip, replace] Merge functional GO terms. Default: add
            "--merge-ips-annotation=add",            // [add, skip, replace] Merge InterPro domain terms. Default: add
            "--main-project=project1"                // [project1, project2] Define priority project layout. Default: project1
        ].join(' ')
    }

    withName: 'MERGE_EGGNOG_5_GOS' {
        ext.outdir = '13_merge_eggnog'
        ext.args = [
            "--evalue-filter=10",                    // [integer] Discard alignments with higher E-Value. Default: 10
            "--bit-score-filter=10.0"                // [float] Discard alignments with lower bit-score. Default: 10.0
        ].join(' ')
    }
}
